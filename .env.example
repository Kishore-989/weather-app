# ============================================
#  Weather App — Environment Variables
# ============================================
#
#  1. Get a FREE API key from:
#     https://openweathermap.org/api
#
#  2. Sign up → go to "API keys" tab → copy key
#
#  3. Replace YOUR_API_KEY_HERE below with it
#
#  4. Rename this file from .env.example → .env
#
# ============================================

REACT_APP_WEATHER_API_KEY=YOUR_API_KEY_HERE
REACT_APP_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
